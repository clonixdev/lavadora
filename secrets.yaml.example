# Copiar este archivo como secrets.yaml en la misma carpeta que tu YAML de ESPHome
# (por ejemplo junto a atalaya06.yaml). No subas secrets.yaml al repositorio.

wifi_ssid: "TU_WIFI_SSID"
wifi_password: "TU_WIFI_PASSWORD"

# Clave de cifrado API (Home Assistant). Generar una nueva, por ejemplo:
#   openssl rand -base64 32
api_encryption_key: "REEMPLAZAR_CON_BASE64"

# Contraseña OTA de ESPHome
ota_password: "REEMPLAZAR_OTA"

# Contraseña del punto de acceso de respaldo (captive portal)
captive_ap_password: "REEMPLAZAR_AP"
